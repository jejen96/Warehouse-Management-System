@model IEnumerable<GRNDto>
@{ ViewData["Title"] = "Goods Receipt Notes"; ViewData["Breadcrumb"] = "GRN"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <div><h4><i class="bi bi-clipboard-check me-2 text-primary"></i>Goods Receipt Notes (GRN)</h4><p>@ViewBag.TotalCount records</p></div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>GRN Number</th><th>Date</th><th>PO Number</th><th>Received By</th><th>Status</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No GRN records</td></tr> }
                @foreach (var g in Model)
                {
                    <tr>
                        <td class="fw-semibold text-primary">@g.GRNNumber</td>
                        <td>@g.GRNDate.ToString("dd MMM yyyy")</td>
                        <td>@g.PONumber</td>
                        <td>@g.ReceivedBy</td>
                        <td><span class="badge badge-@g.Status.ToLower()">@g.Status</span></td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@g.Id" class="btn btn-action btn-outline-info"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="card-footer">
            <nav><ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul></nav>
        </div>
    }
</div>
