@model IEnumerable<SalesOrderDto>
@{ ViewData["Title"] = "Sales Orders"; ViewData["Breadcrumb"] = "Sales Orders"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <div><h4><i class="bi bi-cart3 me-2 text-success"></i>Sales Orders</h4><p>@ViewBag.TotalCount records</p></div>
</div>

<div class="card">
    <div class="card-header d-flex gap-2 flex-wrap">
        @foreach (var s in new[] { "", "Draft", "Confirmed", "Picking", "Shipped", "Closed" })
        {
            <a asp-action="Index" asp-route-status="@(s == "" ? null : s)"
               class="btn btn-sm @(ViewBag.Status == (s == "" ? null : s) ? "btn-success" : "btn-outline-secondary")">
                @(s == "" ? "All" : s)
            </a>
        }
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>SO Number</th><th>Date</th><th>Customer</th><th>Status</th><th>Notes</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No sales orders</td></tr> }
                @foreach (var so in Model)
                {
                    <tr>
                        <td class="fw-semibold text-success">@so.SONumber</td>
                        <td>@so.SODate.ToString("dd MMM yyyy")</td>
                        <td>@so.CustomerName</td>
                        <td><span class="badge badge-@so.Status.ToLower()">@so.Status</span></td>
                        <td class="text-muted">@(so.Notes ?? "-")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@so.Id" class="btn btn-action btn-outline-info"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</small>
            <nav><ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul></nav>
        </div>
    }
</div>
