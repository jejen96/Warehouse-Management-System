@model ItemDto
@{ ViewData["Title"] = "Item Details"; ViewData["Breadcrumb"] = "Item Details"; }

<div class="page-header d-flex justify-content-between">
    <div>
        <h4><i class="bi bi-box-seam me-2 text-primary"></i>@Model.ItemCode</h4>
        <p>@Model.ItemName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">Item Details</div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><th style="width:40%" class="text-muted">Item Code</th><td class="fw-semibold">@Model.ItemCode</td></tr>
                    <tr><th class="text-muted">Item Name</th><td>@Model.ItemName</td></tr>
                    <tr><th class="text-muted">Description</th><td>@(Model.Description ?? "-")</td></tr>
                    <tr><th class="text-muted">Category</th><td><span class="badge bg-light text-dark">@(Model.Category ?? "-")</span></td></tr>
                    <tr><th class="text-muted">UOM</th><td>@Model.UOM</td></tr>
                    <tr><th class="text-muted">Min Stock</th><td>@Model.MinStock.ToString("N2")</td></tr>
                    <tr><th class="text-muted">Max Stock</th><td>@Model.MaxStock.ToString("N2")</td></tr>
                    <tr>
                        <th class="text-muted">Status</th>
                        <td>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
