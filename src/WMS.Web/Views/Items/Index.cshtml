@model IEnumerable<ItemDto>
@{ ViewData["Title"] = "Items"; ViewData["Breadcrumb"] = "Items"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4><i class="bi bi-box-seam me-2 text-primary"></i>Items</h4>
        <p>@ViewBag.TotalCount items total</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Item
    </a>
</div>

<div class="card">
    <div class="card-header">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search item code or name..." style="max-width:300px" />
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search"></i></button>
            @if (!string.IsNullOrEmpty(ViewBag.Search))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
            }
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Item Code</th>
                        <th>Item Name</th>
                        <th>Category</th>
                        <th>UOM</th>
                        <th class="text-end">Min Stock</th>
                        <th class="text-end">Max Stock</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No items found</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-primary">@item.ItemCode</td>
                            <td>@item.ItemName<br/><small class="text-muted">@item.Description</small></td>
                            <td><span class="badge bg-light text-dark">@(item.Category ?? "-")</span></td>
                            <td>@item.UOM</td>
                            <td class="text-end">@item.MinStock.ToString("N2")</td>
                            <td class="text-end">@item.MaxStock.ToString("N2")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-action btn-outline-info"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-action btn-outline-warning"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete @item.ItemName?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-action btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
