<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        :root { --sidebar-width: 260px; --primary: #0d6efd; }
        body { background: #f0f2f5; font-family: 'Segoe UI', sans-serif; }

        /* Sidebar */
        #sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background: linear-gradient(180deg, #1e3a5f 0%, #0d2137 100%);
            position: fixed; top: 0; left: 0; z-index: 100;
            transition: all 0.3s;
            overflow-y: auto;
        }
        #sidebar .sidebar-brand {
            padding: 1.2rem 1.5rem;
            background: rgba(255,255,255,0.05);
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        #sidebar .sidebar-brand h5 { color: #fff; margin: 0; font-weight: 700; font-size: 1.1rem; }
        #sidebar .sidebar-brand small { color: rgba(255,255,255,0.5); font-size: 0.75rem; }
        #sidebar .nav-section {
            padding: 1rem 1rem 0.3rem;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
            font-weight: 600;
        }
        #sidebar .nav-link {
            color: rgba(255,255,255,0.75);
            padding: 0.6rem 1.5rem;
            border-radius: 0;
            display: flex; align-items: center; gap: 0.75rem;
            font-size: 0.875rem;
            transition: all 0.2s;
            border-left: 3px solid transparent;
        }
        #sidebar .nav-link:hover, #sidebar .nav-link.active {
            color: #fff;
            background: rgba(255,255,255,0.1);
            border-left-color: #0d6efd;
        }
        #sidebar .nav-link i { width: 18px; text-align: center; font-size: 1rem; }

        /* Topbar */
        #topbar {
            margin-left: var(--sidebar-width);
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            padding: 0.75rem 1.5rem;
            position: sticky; top: 0; z-index: 99;
            display: flex; align-items: center; justify-content: space-between;
        }

        /* Main content */
        #main-content {
            margin-left: var(--sidebar-width);
            padding: 1.5rem;
            min-height: 100vh;
        }

        /* Cards */
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        .card-header { background: #fff; border-bottom: 1px solid #f0f0f0; border-radius: 12px 12px 0 0 !important; padding: 1rem 1.25rem; font-weight: 600; }

        /* Stat cards */
        .stat-card { border-radius: 12px; padding: 1.25rem; color: #fff; }
        .stat-card .stat-icon { font-size: 2rem; opacity: 0.8; }
        .stat-card .stat-number { font-size: 2rem; font-weight: 700; }
        .stat-card .stat-label { font-size: 0.85rem; opacity: 0.85; }

        /* Table */
        .table th { background: #f8f9fa; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: #6c757d; font-weight: 600; border-bottom: 2px solid #e9ecef; }
        .table td { vertical-align: middle; font-size: 0.875rem; }

        /* Badge status */
        .badge-draft { background: #e9ecef; color: #495057; }
        .badge-confirmed { background: #cfe2ff; color: #0a58ca; }
        .badge-received, .badge-completed { background: #d1e7dd; color: #0f5132; }
        .badge-closed { background: #f8d7da; color: #842029; }
        .badge-picking { background: #fff3cd; color: #664d03; }
        .badge-shipped { background: #d1e7dd; color: #0f5132; }

        /* Page header */
        .page-header { margin-bottom: 1.5rem; }
        .page-header h4 { font-weight: 700; color: #1e3a5f; margin: 0; }
        .page-header p { color: #6c757d; font-size: 0.875rem; margin: 0; }

        /* Responsive */
        @@media (max-width: 768px) {
            #sidebar { transform: translateX(-100%); }
            #sidebar.show { transform: translateX(0); }
            #topbar, #main-content { margin-left: 0; }
        }

        .btn-action { padding: 0.25rem 0.6rem; font-size: 0.8rem; }
        .breadcrumb { font-size: 0.8rem; background: none; padding: 0; margin: 0; }
        .breadcrumb-item + .breadcrumb-item::before { color: #adb5bd; }
    </style>
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Sidebar -->
    <nav id="sidebar">
        <div class="sidebar-brand">
            <h5><i class="bi bi-boxes me-2"></i>WMS</h5>
            <small>Warehouse Management</small>
        </div>

        <div class="pt-2">
            <div class="nav-section">Main</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
               asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <div class="nav-section">Master Data</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Items" ? "active" : "")"
               asp-controller="Items" asp-action="Index">
                <i class="bi bi-box-seam"></i> Items
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warehouses" ? "active" : "")"
               asp-controller="Warehouses" asp-action="Index">
                <i class="bi bi-building"></i> Warehouses
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vendors" ? "active" : "")"
               asp-controller="Vendors" asp-action="Index">
                <i class="bi bi-truck"></i> Vendors
            </a>

            <div class="nav-section">Inbound</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PurchaseOrders" ? "active" : "")"
               asp-controller="PurchaseOrders" asp-action="Index">
                <i class="bi bi-file-earmark-text"></i> Purchase Orders
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "GRN" ? "active" : "")"
               asp-controller="GRN" asp-action="Index">
                <i class="bi bi-clipboard-check"></i> Goods Receipt (GRN)
            </a>

            <div class="nav-section">Inventory</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stock" && ViewContext.RouteData.Values["action"]?.ToString() == "Balance" ? "active" : "")"
               asp-controller="Stock" asp-action="Balance">
                <i class="bi bi-bar-chart-line"></i> Stock Balance
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stock" && ViewContext.RouteData.Values["action"]?.ToString() == "Ledger" ? "active" : "")"
               asp-controller="Stock" asp-action="Ledger">
                <i class="bi bi-journal-text"></i> Stock Ledger
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stock" && ViewContext.RouteData.Values["action"]?.ToString() == "Adjustments" ? "active" : "")"
               asp-controller="Stock" asp-action="Adjustments">
                <i class="bi bi-sliders"></i> Adjustments
            </a>

            <div class="nav-section">Outbound</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SalesOrders" ? "active" : "")"
               asp-controller="SalesOrders" asp-action="Index">
                <i class="bi bi-cart3"></i> Sales Orders
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shipments" ? "active" : "")"
               asp-controller="Shipments" asp-action="Index">
                <i class="bi bi-send"></i> Shipments
            </a>
        </div>
    </nav>

    <!-- Topbar -->
    <div id="topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-sm btn-light d-md-none" onclick="document.getElementById('sidebar').classList.toggle('show')">
                <i class="bi bi-list fs-5"></i>
            </button>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                    @if (ViewData["Breadcrumb"] != null)
                    {
                        <li class="breadcrumb-item active">@ViewData["Breadcrumb"]</li>
                    }
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
            <div class="dropdown">
                <button class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Profile</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div id="main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
