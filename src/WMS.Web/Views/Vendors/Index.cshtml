@model IEnumerable<VendorDto>
@{ ViewData["Title"] = "Vendors"; ViewData["Breadcrumb"] = "Vendors"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <div><h4><i class="bi bi-truck me-2 text-primary"></i>Vendors</h4></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Vendor</a>
</div>

<div class="card">
    <div class="card-header">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search vendor..." style="max-width:280px" />
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search"></i></button>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>Code</th><th>Name</th><th>Contact</th><th>Address</th><th>Status</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No vendors found</td></tr> }
                @foreach (var v in Model)
                {
                    <tr>
                        <td class="fw-semibold text-primary">@v.VendorCode</td>
                        <td>@v.VendorName</td>
                        <td>@(v.Contact ?? "-")</td>
                        <td class="text-muted">@(v.Address ?? "-")</td>
                        <td><span class="badge @(v.IsActive ? "bg-success" : "bg-secondary")">@(v.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-action btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@v.Id" method="post" class="d-inline" onsubmit="return confirm('Delete?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-action btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
