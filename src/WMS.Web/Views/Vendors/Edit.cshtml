@model VendorDto
@{ ViewData["Title"] = "Edit Vendor"; ViewData["Breadcrumb"] = "Edit Vendor"; }
<div class="page-header"><h4><i class="bi bi-pencil me-2 text-warning"></i>Edit Vendor</h4></div>
<div class="row"><div class="col-lg-6">
    <div class="card"><div class="card-header">Vendor Information</div><div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Vendor Name <span class="text-danger">*</span></label>
                    <input asp-for="VendorName" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Contact</label>
                    <input asp-for="Contact" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Address</label>
                    <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-warning text-white">Update</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div></div>
</div></div>
