@model DashboardStats
@{ ViewData["Title"] = "Dashboard"; ViewData["Breadcrumb"] = "Dashboard"; }

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card" style="background:linear-gradient(135deg,#0d6efd,#0a58ca)">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-number">@Model.TotalItems</div>
                    <div class="stat-label">Total Items</div>
                </div>
                <i class="bi bi-box-seam stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card" style="background:linear-gradient(135deg,#198754,#157347)">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-number">@Model.TotalWarehouses</div>
                    <div class="stat-label">Warehouses</div>
                </div>
                <i class="bi bi-building stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card" style="background:linear-gradient(135deg,#fd7e14,#e35d0a)">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-number">@Model.TotalLocations</div>
                    <div class="stat-label">Locations</div>
                </div>
                <i class="bi bi-geo-alt stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card" style="background:linear-gradient(135deg,#6f42c1,#59359a)">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-number">@Model.TotalVendors</div>
                    <div class="stat-label">Vendors</div>
                </div>
                <i class="bi bi-truck stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card" style="background:linear-gradient(135deg,#20c997,#0fa37f)">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-number">@Model.PendingPOs</div>
                    <div class="stat-label">Pending POs</div>
                </div>
                <i class="bi bi-file-earmark-text stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card" style="background:linear-gradient(135deg,#dc3545,#b02a37)">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-number">@Model.PendingSOs</div>
                    <div class="stat-label">Pending SOs</div>
                </div>
                <i class="bi bi-cart3 stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Recent Purchase Orders -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-file-earmark-text text-primary me-2"></i>Recent Purchase Orders</span>
                <a asp-controller="PurchaseOrders" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>PO Number</th>
                                <th>Vendor</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentPOs.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr>
                            }
                            @foreach (var po in Model.RecentPOs)
                            {
                                <tr>
                                    <td><a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@po.Id" class="text-decoration-none fw-semibold">@po.PONumber</a></td>
                                    <td>@po.VendorName</td>
                                    <td>@po.PODate.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge badge-@po.Status.ToLower()">@po.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Sales Orders -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-cart3 text-success me-2"></i>Recent Sales Orders</span>
                <a asp-controller="SalesOrders" asp-action="Index" class="btn btn-sm btn-outline-success">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>SO Number</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentSOs.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr>
                            }
                            @foreach (var so in Model.RecentSOs)
                            {
                                <tr>
                                    <td><a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@so.Id" class="text-decoration-none fw-semibold">@so.SONumber</a></td>
                                    <td>@so.CustomerName</td>
                                    <td>@so.SODate.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge badge-@so.Status.ToLower()">@so.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Stock Balance -->
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-bar-chart-line text-warning me-2"></i>Stock Overview</span>
                <a asp-controller="Stock" asp-action="Balance" class="btn btn-sm btn-outline-warning">View All Stock</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Item Code</th>
                                <th>Item Name</th>
                                <th>Location</th>
                                <th>Warehouse</th>
                                <th class="text-end">Available</th>
                                <th class="text-end">Reserved</th>
                                <th class="text-end">On Hand</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.LowStockItems.Any())
                            {
                                <tr><td colspan="7" class="text-center text-muted py-3">No stock data</td></tr>
                            }
                            @foreach (var s in Model.LowStockItems)
                            {
                                <tr>
                                    <td class="fw-semibold">@s.ItemCode</td>
                                    <td>@s.ItemName</td>
                                    <td><span class="badge bg-light text-dark">@s.LocationCode</span></td>
                                    <td>@s.WarehouseName</td>
                                    <td class="text-end text-success fw-semibold">@s.AvailableQty.ToString("N2")</td>
                                    <td class="text-end text-warning">@s.ReservedQty.ToString("N2")</td>
                                    <td class="text-end fw-bold">@s.OnHandQty.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
