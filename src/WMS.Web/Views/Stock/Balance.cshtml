@model IEnumerable<StockBalanceDto>
@{ ViewData["Title"] = "Stock Balance"; ViewData["Breadcrumb"] = "Stock Balance"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <div><h4><i class="bi bi-bar-chart-line me-2 text-warning"></i>Stock Balance</h4><p>@ViewBag.TotalCount records</p></div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Item Code</th><th>Item Name</th><th>Location</th><th>Warehouse</th>
                    <th class="text-end">Available</th><th class="text-end">Reserved</th><th class="text-end">On Hand</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No stock data</td></tr> }
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold text-primary">@s.ItemCode</td>
                        <td>@s.ItemName</td>
                        <td><span class="badge bg-light text-dark">@s.LocationCode</span></td>
                        <td>@s.WarehouseName</td>
                        <td class="text-end text-success fw-semibold">@s.AvailableQty.ToString("N2")</td>
                        <td class="text-end text-warning">@s.ReservedQty.ToString("N2")</td>
                        <td class="text-end fw-bold">@s.OnHandQty.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</small>
            <nav><ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Balance" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul></nav>
        </div>
    }
</div>
