@model IEnumerable<StockAdjustmentDto>
@{ ViewData["Title"] = "Stock Adjustments"; ViewData["Breadcrumb"] = "Stock Adjustments"; }

<div class="page-header"><h4><i class="bi bi-sliders me-2 text-warning"></i>Stock Adjustments</h4></div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>Adj Number</th><th>Date</th><th>Item</th><th>Location</th><th class="text-end">Qty</th><th>Reason</th><th>Status</th><th class="text-center">Action</th></tr>
            </thead>
            <tbody>
                @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No adjustments</td></tr> }
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="fw-semibold text-primary">@a.AdjNumber</td>
                        <td>@a.AdjDate.ToString("dd/MM/yyyy")</td>
                        <td>@a.ItemName</td>
                        <td><span class="badge bg-light text-dark">@a.LocationCode</span></td>
                        <td class="text-end fw-bold @(a.AdjQty >= 0 ? "text-success" : "text-danger")">
                            @(a.AdjQty >= 0 ? "+" : "")@a.AdjQty.ToString("N2")
                        </td>
                        <td class="text-muted">@a.Reason</td>
                        <td>
                            @if (a.IsApproved)
                            {
                                <span class="badge bg-success">Approved by @a.ApprovedBy</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (!a.IsApproved)
                            {
                                <form asp-action="Approve" asp-route-id="@a.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Approve this adjustment?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-success"><i class="bi bi-check-circle me-1"></i>Approve</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="card-footer">
            <nav><ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Adjustments" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul></nav>
        </div>
    }
</div>
