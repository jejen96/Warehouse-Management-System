@model PurchaseOrderDto
@{ ViewData["Title"] = "PO Details"; ViewData["Breadcrumb"] = "PO Details"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4><i class="bi bi-file-earmark-text me-2 text-primary"></i>@Model.PONumber</h4>
        <p>Vendor: <strong>@Model.VendorName</strong> &nbsp;|&nbsp; Date: @Model.PODate.ToString("dd MMM yyyy")</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge badge-@Model.Status.ToLower() fs-6">@Model.Status</span>
        @if (Model.Status == "Draft")
        {
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="Confirmed" />
                <button class="btn btn-success btn-sm"><i class="bi bi-check-circle me-1"></i>Confirm PO</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="card">
    <div class="card-header">Line Items</div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead><tr><th>#</th><th>Item</th><th>UOM</th><th class="text-end">Ordered Qty</th><th class="text-end">Received Qty</th><th class="text-end">Unit Price</th><th class="text-end">Total</th></tr></thead>
            <tbody>
                @{ int no = 1; decimal grandTotal = 0; }
                @foreach (var d in Model.Details)
                {
                    var total = d.OrderedQty * d.UnitPrice;
                    grandTotal += total;
                    <tr>
                        <td>@no</td>
                        <td>@d.ItemName</td>
                        <td>@d.UOM</td>
                        <td class="text-end">@d.OrderedQty.ToString("N2")</td>
                        <td class="text-end @(d.ReceivedQty >= d.OrderedQty ? "text-success" : "text-warning")">@d.ReceivedQty.ToString("N2")</td>
                        <td class="text-end">@d.UnitPrice.ToString("N2")</td>
                        <td class="text-end fw-semibold">@total.ToString("N2")</td>
                    </tr>
                    no++;
                }
                <tr class="table-light fw-bold">
                    <td colspan="6" class="text-end">Grand Total</td>
                    <td class="text-end">@grandTotal.ToString("N2")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
